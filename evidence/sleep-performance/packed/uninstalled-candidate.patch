-typedef struct { int r, g, b; } color_t;
+/* Palette channels are0..255. Even the component-wise loose light bound
+ * gives light<=47899 and rim<=2, so all composed channels stay0..374.
+ * Ten bits retain that HDR headroom without clipping. Integer promotion of
+ * these bitfields is signed int. A4-byte color returns in one S31 register,
+ * avoiding the old12-byte indirect results and per-pixel stack copies. */
+typedef struct { unsigned r:10, g:10, b:10; } color_t;
+_Static_assert(sizeof(color_t)==4,"color must fit one32-bit return register");
 
 typedef struct {
     int16_t nx, ny, nz; /* nz=-1 is outside the sphere. */
